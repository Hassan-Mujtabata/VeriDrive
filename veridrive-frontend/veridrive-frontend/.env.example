# Copy this file to .env and fill in your real values.
# Vite only exposes variables prefixed with VITE_ to the browser.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — get a free site key at https://dash.cloudflare.com/?to=/:account/turnstile
# If left unset, a Cloudflare test key is used (the widget always passes,
# useful for local dev, but NOT real bot protection — set a real key before
# any real demo/deployment).
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
